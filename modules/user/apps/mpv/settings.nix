{
  home.file.".config/mpv/mpv.conf".text = ''
    keep-open=yes

    [image]
    image-display-duration=inf
    loop-file=inf
    loop-playlist=inf
    mute=yes
    osc=no
    sub-auto=no
    audio-file-auto=no
    term-status-msg=""

    [video]
    mute=no
    osc=yes
    sub-auto=all
    audio-file-auto=all
  '';
}
